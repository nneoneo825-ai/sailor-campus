# ========== 后端配置（复制为 backend/.env 使用）==========

# MySQL 连接串（必填，仅支持 MySQL）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/sailor_campus

# JWT 签名密钥（生产环境务必使用强随机值，可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 允许的前端来源
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 微信小程序凭证（开发期可留空，wechat-login 将进入模拟模式）
WECHAT_APPID=
WECHAT_SECRET=

# 内置管理员后门账号（生产环境建议留空禁用）
BUILTIN_ADMIN_USERNAME=neo
BUILTIN_ADMIN_PASSWORD=

# ========== 前端配置（复制为根目录 .env 使用）==========

# 开发环境指向后端地址；生产环境由 Nginx 代理，留空即可
VITE_API_BASE_URL=http://localhost:8000
