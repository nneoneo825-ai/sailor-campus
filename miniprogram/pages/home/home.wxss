/* 首页样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.greeting .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e293b;
}

.greeting .subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.notification {
  font-size: 48rpx;
  padding: 16rpx;
  background-color: #f1f5f9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 快捷入口 */
.quick-entries {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.1s;
}

.entry-item:active {
  transform: scale(0.95);
}

.entry-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.entry-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #475569;
  white-space: nowrap;
}

/* 区块样式 */
.section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  background-color: #dbeafe;
  color: #2563eb;
  border-radius: 100rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.action-btn.primary {
  background-color: #e0e7ff;
  color: #4f46e5;
}

.action-btn .iconfont {
  font-size: 20rpx;
}

.link-text {
  font-size: 24rpx;
  color: #3b82f6;
}

/* 任务列表 */
.task-list {
  background-color: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid #f1f5f9;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.task-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-bottom: 2rpx solid #f8fafc;
  transition: background-color 0.1s;
}

.task-item:active {
  background-color: #f8fafc;
}

.task-item:last-child {
  border-bottom: none;
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.status-icon[data-status="completed"] {
  color: #10b981;
}

.task-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.task-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
}

.task-title.completed {
  color: #94a3b8;
  text-decoration: line-through;
}

.task-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

/* 记录列表 */
.empty-state {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx;
  border: 2rpx solid #f1f5f9;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.record-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.record-icon.teaching {
  background-color: #d1fae5;
}

.record-icon.dorm {
  background-color: #ede9fe;
}

.record-content {
  flex: 1;
}

.record-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.record-type {
  font-size: 20rpx;
  font-weight: 600;
  color: #3b82f6;
  background-color: #eff6ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.record-target {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.record-detail {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-score {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.record-score.positive {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.record-score.negative {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}
