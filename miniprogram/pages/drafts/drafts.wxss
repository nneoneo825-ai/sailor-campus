/* 草稿页面样式 */
.container {
  min-height: 100vh;
  padding: 32rpx;
  background-color: #f8fafc;
}

.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1e293b;
}

.count {
  font-size: 28rpx;
  color: #64748b;
  background-color: #e2e8f0;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

/* 草稿列表 */
.draft-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.empty-state {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 80rpx 32rpx;
  text-align: center;
  border: 2rpx solid #f1f5f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #94a3b8;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #cbd5e1;
}

.draft-item {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #f1f5f9;
  transition: all 0.3s;
}

.draft-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.draft-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.draft-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.draft-type {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
}

.draft-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.draft-target {
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.4;
}

.draft-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.draft-category,
.draft-item {
  font-size: 24rpx;
  color: #64748b;
  background-color: #f8fafc;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.draft-delete {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #cbd5e1;
  cursor: pointer;
  transition: all 0.3s;
}

.draft-delete:active {
  color: #ef4444;
  transform: scale(1.1);
}
