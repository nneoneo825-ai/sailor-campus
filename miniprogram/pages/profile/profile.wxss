/* 全局样式 */
.container {
  min-height: 100vh;
  background-color: #f1f5f9;
  padding: 32rpx;
}

.sub-page {
  min-height: 100vh;
  background-color: #f1f5f9;
  padding: 32rpx;
}

/* 主页面样式 */
/* 用户信息头部 */
.header-section {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 48rpx;
  padding: 64rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.3);
  margin-bottom: -48rpx;
  position: relative;
}

.avatar-container {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 8rpx;
}

.user-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.user-tag {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
}

.role-tag {
  background-color: rgba(255, 255, 255, 0.2);
}

.dept-tag {
  background-color: rgba(255, 255, 255, 0.15);
}

/* 登录提示 */
.login-prompt {
  margin-top: 24rpx;
}

.login-prompt-btn {
  background-color: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  line-height: 1.5;
}

.login-prompt-btn::after {
  border: none;
}

/* 统计数据 */
.stats-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 64rpx 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(241, 245, 249, 0.8);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #1e293b;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background-color: #e2e8f0;
  margin: 0 16rpx;
}

/* 菜单列表 */
.menu-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8fafc;
}

.menu-icon {
  font-size: 40rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-count {
  background-color: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  min-width: 32rpx;
  text-align: center;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
  font-weight: 300;
}

/* 退出登录 */
.logout-section {
  margin: 32rpx 0;
}

.logout-btn {
  width: 100%;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.3);
}

.logout-btn:active {
  transform: scale(0.98);
}

.logout-icon {
  font-size: 32rpx;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 32rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 子页面通用样式 */
.sub-header {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s;
}

.back-btn:active {
  background-color: #e2e8f0;
}

.back-icon {
  font-size: 32rpx;
  color: #64748b;
  font-weight: bold;
}

.sub-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e293b;
  flex: 1;
}

/* 我的提交页面 */
.submissions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.submission-item {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #f1f5f9;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.submission-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.type-badge {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: bold;
  color: #ffffff;
}

.type-moral {
  background-color: #3b82f6;
}

.type-teaching {
  background-color: #10b981;
}

.type-dorm {
  background-color: #8b5cf6;
}

.type-overall {
  background-color: #f59e0b;
}

.submission-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  flex: 1;
}

.submission-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.location-icon {
  font-size: 20rpx;
}

.location-text {
  font-size: 22rpx;
  color: #3b82f6;
  font-weight: 500;
}

.submission-category {
  font-size: 22rpx;
  color: #64748b;
}

.submission-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f5f9;
}

.submission-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.submission-detail {
  font-size: 20rpx;
  font-weight: bold;
  color: #3b82f6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
  color: #94a3b8;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 部门信息页面 */
.dept-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.dept-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background-color: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.dept-icon {
  font-size: 64rpx;
  color: #3b82f6;
}

.dept-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
}

.dept-desc {
  font-size: 20rpx;
  color: #94a3b8;
}

.members-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f1f5f9;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
}

.member-role {
  font-size: 20rpx;
  color: #64748b;
}

.member-status {
  padding: 6rpx 16rpx;
  background-color: #dbeafe;
  color: #1d4ed8;
  font-size: 18rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

/* 消息通知页面 */
.header-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.ignore-all {
  font-size: 24rpx;
  font-weight: bold;
  color: #3b82f6;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}

.ignore-all:active {
  background-color: #dbeafe;
}

.notifications-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notification-item {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #f1f5f9;
  display: flex;
  gap: 24rpx;
  position: relative;
}

.notification-item.unread {
  border-color: #dbeafe;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.1);
}

.notification-dot {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ef4444;
  border-radius: 50%;
}

.notification-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.notification-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notification-time {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 系统设置页面 */
.settings-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
  transition: background-color 0.2s;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background-color: #f8fafc;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.setting-icon {
  font-size: 32rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-label {
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-value {
  font-size: 24rpx;
  color: #94a3b8;
}

.setting-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
  font-weight: 300;
}

.setting-switch {
  transform: scale(0.9);
}

/* 帮助与反馈页面 */
.help-section,
.feedback-section,
.contact-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.faq-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
  transition: background-color 0.2s;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-item:active {
  background-color: #f8fafc;
}

.faq-text {
  font-size: 28rpx;
  color: #334155;
  flex: 1;
}

.faq-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
  font-weight: 300;
}

.feedback-input {
  width: 100%;
  height: 256rpx;
  padding: 24rpx;
  background-color: #f1f5f9;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #334155;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.feedback-submit {
  width: 100%;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.feedback-submit:active {
  transform: scale(0.98);
}

.feedback-submit:disabled {
  background: #cbd5e1;
  box-shadow: none;
}

.submit-icon {
  font-size: 32rpx;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.contact-item {
  background-color: #f8fafc;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.contact-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.phone-icon {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.mail-icon {
  background-color: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}

.contact-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #1e293b;
}

.contact-value {
  font-size: 20rpx;
  color: #64748b;
}

/* 微信绑定状态 */
.setting-value.bound {
  color: #10b981;
}

.setting-value.unbound {
  color: #94a3b8;
}
