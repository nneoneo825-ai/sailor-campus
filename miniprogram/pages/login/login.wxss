/* 登录页面样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  margin-top: 60rpx;
}

.logo-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录表单 */
.login-form {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e40af;
  text-align: center;
  margin-bottom: 10rpx;
}

.form-desc {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 50rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 90rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #9ca3af;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #9ca3af;
  opacity: 0.8;
}

.login-btn.loading {
  opacity: 0.8;
}

.switch-mode {
  text-align: center;
  margin-top: 30rpx;
}

.switch-text {
  font-size: 28rpx;
  color: #6b7280;
}

/* 微信登录区域 */
.wechat-login-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-tips {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.wechat-login-btn {
  width: 100%;
  height: 100rpx;
  background: #ffffff;
  color: #1e40af;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: none;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn[disabled] {
  background: rgba(255, 255, 255, 0.6);
}

.wechat-login-btn.loading {
  opacity: 0.8;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.bind-hint {
  margin-top: 50rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.bind-link {
  color: #ffffff;
  margin-left: 10rpx;
  text-decoration: underline;
}

/* 底部信息 */
.footer-info {
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
}

.version {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  margin-bottom: 8rpx;
}

.copyright {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 服务器配置 */
.server-config {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.config-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e40af;
  margin-bottom: 20rpx;
}

.config-input-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.config-input {
  flex: 1;
  height: 70rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.config-btn {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 8rpx;
  padding: 0 24rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.current-url {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 16rpx;
  word-break: break-all;
}
